NODE_ENV=production
PORT=3000
APP_ORIGIN=https://marginlift.ir
SESSION_SECRET=replace-with-a-random-value-at-least-32-characters
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
ARTIFACT_ENCRYPTION_KEY=replace-with-64-hex-characters
ARTIFACT_KEY_VERSION=v1
MARGINLIFT_DB_PATH=/app/data/db.json
MARGINLIFT_FONT_DIR=/app/private/fonts
MARGINLIFT_MAX_BODY_BYTES=2097152
TRUST_PROXY=true
MARGINLIFT_LOG_LEVEL=info
MARGINLIFT_PUBLIC_SIGNUP=false
JWT_SECRET=replace-with-a-random-value-at-least-32-characters
SHADOW_SCORER_URL=http://shadow-scorer:8100
SCORER_INTERNAL_TOKEN=replace-with-a-random-value-at-least-32-characters
SCORER_INTERNAL_TOKEN_ID=v1
SCORER_INTERNAL_TOKEN_PREVIOUS=
ORCHESTRATION_DRIFT_THRESHOLD=0.2
REVENUE_SHARE_RATE=0.2
CADDY_EMAIL=replace-with-ops-email@example.com
